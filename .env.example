# Copy to .env for local development. Never commit real secrets.
API_PORT=4000
# Web -> API proxy target (server side) and public web URL used in parent links
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Prototype store location (relative to apps/api) and demo seeding
DATA_DIR=data
SEED_DEMO_DATA=true
# Optional: enables the "live AI" switch in the question assistant. Leave empty to stay fully offline.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
