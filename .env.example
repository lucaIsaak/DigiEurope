# Copy to .env for local development. Never commit real secrets.
POSTGRES_USER=digieurope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=digieurope
DATABASE_URL=postgres://digieurope:change-me@localhost:5432/digieurope
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Web -> API proxy target (server side) and public web URL used in landlord links
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Prototype store location (relative to apps/api) and demo seeding
DATA_DIR=data
SEED_DEMO_DATA=true
