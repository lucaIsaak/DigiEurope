# Copy to .env for local development. Never commit real secrets.
API_PORT=4000
# Web -> API proxy target (server side) and public web URL used in parent links
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Prototype store location (relative to apps/api) and demo seeding
DATA_DIR=data
SEED_DEMO_DATA=true
# Optional: enables the "live AI" switch in the question assistant. Leave empty to stay fully offline.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Process from a description (builder, "Describe a process"): with a key, a "Live AI" option appears next to the simulated writer.
# PROCESS_AI_MODEL=claude-sonnet-5-5

# Always-on agents: a tick every AGENT_TICK_MS (default 120000 = 2 minutes). Without a key everything still runs;
# documents the template reader cannot read then go to an employee instead of a model.
# OPENROUTER_API_KEY=
# Cheap by default. Any OpenRouter model id works, for example a free one ending in ":free".
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# AGENT_TICK_MS=120000
